# Required: generate with `openssl rand -base64 32`; never use a public example key.
JWT_SECRET=

# Optional: leave empty to use the local retrieval-only assistant.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Used by local development and Docker Compose.
PORT=8080
CORS_ALLOWED_ORIGIN=http://localhost:3000,http://127.0.0.1:3000
DATABASE_URL=jdbc:h2:file:./data/stitchai;DB_CLOSE_ON_EXIT=FALSE
DATABASE_USERNAME=sa
DATABASE_PASSWORD=
